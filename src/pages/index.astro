          </div>
          <div class="stat">
            <span class="value">4.2s</span>
            <span class="label">Median Latency</span>
          </div>
          <div class="stat">
            <span class="value">8 LOIs</span>
            <span class="label">$25K MRR Projected</span>
          </div>
          <div class="stat">
            <span class="value">25+</span>
            <span class="label">POC Pipeline</span>
          </div>
          <div class="stat">
            <span class="value">770</span>
            <span class="label">Active Nodes Daily</span>
          </div>
        </div>

        <div class="two-col" style="margin-top:2.5rem;">
          <div>
            <h3>Live Now</h3>
