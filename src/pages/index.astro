            <div class="member-bg">Oasis CEX Exchange CTO &middot; Traport CTO &middot; Alpine Research CTO</div>
            <div class="member-edu">Soongsil Univ. Computer Science</div>
          </div>
          <div class="team-member">
            <div class="member-name">Jayden</div>
            <div class="member-role">Advisor</div>
            <div class="member-bg">Samsung Electronics LLM RAG Architect &middot; Humax Embedded SW Developer</div>
            <div class="member-edu">Sungkyunkwan Univ. Ph.D in MoT</div>
          </div>
          <div class="team-member">
            <div class="member-expertise">Web3 Strategy Expert</div>
            <div class="member-name">TW</div>
