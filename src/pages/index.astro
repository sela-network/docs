    <!-- ============ 9. WHY WE WIN ============ -->
    <section class="slide" data-slide="8">
      <div class="slide-inner">
        <span class="badge">Why We Win</span>
        <h2>Competitive Landscape</h2>
        <p>Others sell tools or access. Selanet builds the infrastructure layer AI depends on.</p>

        <div class="quadrant">
          <!-- Axes -->
