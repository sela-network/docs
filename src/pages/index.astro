  <!-- NAVIGATION SCRIPT              -->
  <!-- ============================== -->
  <script>
    const deck = document.getElementById("deck")!;
    const dots = document.querySelectorAll<HTMLButtonElement>(".dot-nav button");
    const slideNum = document.getElementById("slideNumber")!;
    const slides = document.querySelectorAll<HTMLElement>(".slide");
    const sidebarBtns = document.querySelectorAll<HTMLButtonElement>(".sidebar-slide");
    const presentBtn = document.getElementById("presentBtn")!;
    const exitPresentBtn = document.getElementById("exitPresentBtn")!;
    const total = slides.length;
    let current = 0;

    function updateUI(index: number) {
      current = index;
      slideNum.textContent = `${index + 1} / ${total}`;
      dots.forEach((d, i) => d.classList.toggle("active", i === index));
      sidebarBtns.forEach((b, i) => b.classList.toggle("active", i === index));
      const activeBtn = sidebarBtns[index];
      if (activeBtn) {
        activeBtn.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }
    }

    function goTo(index: number) {
      slides[index]?.scrollIntoView({ behavior: "smooth" });
    }

    dots.forEach((d) =>
      d.addEventListener("click", () => goTo(Number(d.dataset.index)))
    );

    sidebarBtns.forEach((b) =>
      b.addEventListener("click", () => goTo(Number(b.dataset.index)))
    );

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = Number((e.target as HTMLElement).dataset.slide);
            updateUI(idx);
            e.target.classList.add("in-view");
          }
        });
      },
      { root: deck, threshold: 0.55 }
    );

    slides.forEach((s) => io.observe(s));

    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowRight" || e.key === " ") {
        e.preventDefault();
        if (current < total - 1) goTo(current + 1);
      }
      if (e.key === "ArrowUp" || e.key === "ArrowLeft") {
        e.preventDefault();
        if (current > 0) goTo(current - 1);
      }
      if (e.key === "Escape") {
        document.body.classList.remove("presenting");
      }
    });

    presentBtn.addEventListener("click", () => {
      document.body.classList.add("presenting");
    });

    exitPresentBtn.addEventListener("click", () => {
      document.body.classList.remove("presenting");
    });

    updateUI(0);
    slides[0]?.classList.add("in-view");
  </script>
</PitchDeck>
